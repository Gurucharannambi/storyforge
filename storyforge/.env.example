# Copy this file to `.env` and adjust as needed. Every value here already
# has a working free default in backend/config.py — you only need to
# change what you want to customize.

# ---- Story text model -------------------------------------------------
# "ollama" (recommended, free, local) or "openai_compat" (LM Studio /
# text-generation-webui / vLLM / llama.cpp server)
STORYFORGE_LLM_BACKEND=ollama
OLLAMA_HOST=http://localhost:11434
STORYFORGE_LLM_MODEL=qwen2.5:7b-instruct

# If using openai_compat instead:
# STORYFORGE_LLM_BASE_URL=http://localhost:1234/v1
# STORYFORGE_LLM_API_KEY=not-needed

# ---- Illustration model ------------------------------------------------
# "pollinations" (free hosted, zero setup, needs internet)
# "diffusers"    (fully local SDXL/FLUX/SD1.5, needs a GPU + extra installs)
# "automatic1111"(talk to your own local SD WebUI)
STORYFORGE_IMAGE_BACKEND=pollinations
STORYFORGE_POLLINATIONS_MODEL=flux

# If using diffusers instead:
# STORYFORGE_DIFFUSERS_MODEL=stabilityai/sdxl-turbo
# STORYFORGE_DIFFUSERS_DEVICE=auto

# If using automatic1111 instead:
# STORYFORGE_A1111_URL=http://127.0.0.1:7860

STORYFORGE_IMAGE_WIDTH=768
STORYFORGE_IMAGE_HEIGHT=768

# ---- Server -------------------------------------------------------------
STORYFORGE_HOST=0.0.0.0
STORYFORGE_PORT=8000

# Free Pollinations key (recommended - the no-key tier often returns "402 Payment
# Required"). Get one in a minute at https://enter.pollinations.ai
# STORYFORGE_POLLINATIONS_KEY=

# --- Database -------------------------------------------------------------
# Default: local SQLite file at data/storyforge.db (nothing to set up).
# For CLOUD storage paste a Postgres connection string, e.g. from a free
# Supabase or Neon project:
# STORYFORGE_DATABASE_URL=postgresql://user:password@host:5432/dbname

